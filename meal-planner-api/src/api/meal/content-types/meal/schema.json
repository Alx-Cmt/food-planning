{
  "kind": "collectionType",
  "collectionName": "meals",
  "info": {
    "singularName": "meal",
    "pluralName": "meals",
    "displayName": "Meal"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Name": {
      "type": "string"
    },
    "Description": {
      "type": "text"
    },
    "Difficulty": {
      "type": "enumeration",
      "enum": [
        "Facile",
        "Moyen",
        "Difficile"
      ]
    },
    "ingredients": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::ingredient.ingredient",
      "mappedBy": "meals"
    },
    "calendars": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::calendar.calendar",
      "mappedBy": "meal"
    },
    "Recipe": {
      "type": "text"
    }
  }
}
